{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-integrated-20261102-integrated-preview-20261102.up.railway.app/api/:path*"
    }
  ],
  "build": {
    "env": {
      "NITRO_PRESET": "vercel",
      "VITE_PORTWATCH_AUTH_MODE": "production"
    }
  }
}
