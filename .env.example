# India PortWatch -- configuration.
#
# Every value here has a working default. The system runs with no .env at all:
# the connectors fall back to their local caches and the provenance layer
# reports the degradation instead of hiding it. Copy this file to .env and edit
# only what you need.

# --- API --------------------------------------------------------------------
# Origins allowed to call the API. In production set this to the exact deployed
# terminal origin, e.g. https://portwatch\.example\.com
PORTWATCH_CORS_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# --- Pipeline ---------------------------------------------------------------
# auto | portwatch | real | sample
PORTWATCH_SOURCE=portwatch
# ensemble | tft | baseline
PORTWATCH_MODEL=ensemble
# Minutes between refreshes for scripts/live_refresh.py
PORTWATCH_REFRESH_MINUTES=30

# --- Live data sources (all keyless; override only to pin a different feed) ---
# IMF PortWatch daily chokepoint transits (ArcGIS FeatureServer query URL).
PORTWATCH_CHOKEPOINTS_URL=https://services9.arcgis.com/weJ1QsnbMYJlCHdG/ArcGIS/rest/services/Daily_Chokepoints_Data/FeatureServer/0/query

# Open-Meteo (surface + marine + ERA5 archive) and GDELT DOC 2.0 need no key.
# FRED macro series are read through the public CSV endpoints.

# --- Licence mode and live sources -----------------------------------------
# The mode this process runs in: RESEARCH | DEMO | COMMERCIAL | GOVERNMENT.
# Defaults to COMMERCIAL, the most restrictive reading, in which the
# non-commercial products (Open-Meteo free host, AISStream) are never called.
# The demo needs DEMO. See docs/SIGNAL_FABRIC.md.
PORTWATCH_LICENCE_MODE=DEMO

# AISStream websocket key. Read on the server, never sent to a browser.
# Traffic becomes LIVE_AIS only once valid messages actually arrive.
# AISSTREAM_API_KEY=

# Open-Meteo API subscription key. Selects the customer host, which permits
# commercial use of the same marine and weather data.
# OPEN_METEO_API_KEY=

# Append every raw AIS envelope to a JSON-lines file (bounded in memory
# regardless), and/or replay such a file at startup instead of dialing. A
# replay keeps the recorded timestamps: yesterday's recording is stale today.
# PORTWATCH_AIS_RECORD_PATH=data/cache/ais_session.jsonl
# PORTWATCH_AIS_REPLAY_PATH=

# --- Backend public-port collection -----------------------------------------
# Collect official Paradip/Chennai PDFs every three hours while backend is LIVE.
# Keep one scheduler process per shared SQLite state volume. The defaults below
# are enabled; collection no longer depends on a Codex automation.
PORTWATCH_FRESHNESS_SCHEDULER=1
PORTWATCH_PUBLIC_PORT_AUTOREFRESH=1
PORTWATCH_IDENTITY_MODE=verified
# Keep this directory persistent and reuse existing state when migrating.
# PORTWATCH_STATE_DIR=outputs

# Immutable public historical releases; never point this at private state.
# PORTWATCH_PUBLIC_RESEARCH_DIR=data/research_release

# Optional richer vessel JSON; disabled unless explicitly enabled with a key.
# VesselFinder requires credits; port coverage remains unverified.
PORTWATCH_VESSELFINDER_ENABLED=0
# VESSELFINDER_API_KEY=

# --- Terminal ---------------------------------------------------------------
# Vite inlines VITE_* at build time, so this belongs in
# india-portwatch-terminal/.env (or a --build-arg for the Docker image).
# Leave unset to call /api on the terminal's own origin behind a reverse proxy.
VITE_PORTWATCH_API_BASE=http://localhost:8000/api
VITE_PORTWATCH_AUTH_MODE=production

# --- Optional infrastructure -------------------------------------------------
# Without these the storage layer uses SQLite and the bus runs in-memory.
# DATABASE_URL=postgresql+psycopg2://logistics:logistics@localhost:5432/logistics
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Optional API and collector overrides -----------------------------------
# The process environment takes precedence over this file. Restart after editing.
# Unset paths use the corresponding checkout or durable-state defaults.

# Identity database and private fleet provider JSON.
# PORTWATCH_AUTH_DB=
# PORTWATCH_FLEET_PROVIDER=

# Retained input, feedback, research and route reference artifacts.
# PORTWATCH_CURRENT_ENVIRONMENT_DIR=
# PORTWATCH_EXPERIMENT_DIR=
# PORTWATCH_FREE_SOURCE_DIR=
# Shared source ingest snapshot store. Use a dedicated database for trials.
# PORTWATCH_SOURCE_SNAPSHOT_URL=postgresql+psycopg2://user:password@localhost:5432/portwatch_sources
# PORTWATCH_PUBLIC_CASE_DIR=
# PORTWATCH_PUBLIC_EVIDENCE_SEED_MANIFEST=
# PORTWATCH_PUBLIC_FEEDBACK_DB=
# PORTWATCH_PUBLIC_TARIFFS=
# PORTWATCH_SEA_ROUTES=
# PORTWATCH_WEATHER_FEEDBACK_DB=
# PORTWATCH_WEATHER_FEEDBACK_REPORT=

# Background jobs and source profiles. Reconciliation and pipeline refresh
# default to enabled. The public research profile and NHO collection opt in.
# PORTWATCH_INTELLIGENCE_RECONCILIATION=1
# PORTWATCH_WEATHER_RECONCILIATION=1
# PORTWATCH_PIPELINE_AUTOREFRESH=1
# PORTWATCH_RESEARCH_SOURCE_PROFILE=0
# PORTWATCH_LOCAL_PROVIDER_PROFILE=0
# PORTWATCH_NHO_ENABLED=0

# Optional AIS geometry override and frozen panel rehearsal clock.
# PORTWATCH_AIS_BOUNDING_BOXES=
# PORTWATCH_PANEL_SNAPSHOT_AT=2026-11-04T00:00:00Z

# Optional provider credentials. Keep their values in the server environment.
# DATA_GOV_IN_API_KEY=
# DATA_GOV_IN_PORT_RESOURCE_ID=
# EIA_API_KEY=
# OCEANS_X_API_KEY=

# Hosted release binding. Railway supplies its own deployment identifiers.
# PORTWATCH_RELEASE_ENVIRONMENT=
# PORTWATCH_RELEASE_SHA=
# PORTWATCH_REQUIRE_RELEASE_MANIFEST=0
# RAILWAY_DEPLOYMENT_ID=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_SERVICE_ID=
